--- !u!114 &1729284566
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1729284564}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u603B\u7ED3\uFF1A\u4ECE\u201C\u5BB6\u201D\u5230\u201C\u56FD\u201D\u7684\u540C\u6784\u4E0E\u5347\u534E\r\n\u4E2D\u56FD\u53E4\u4EE3\u6C11\u5C45\u4E0E\u6545\u5BAB\u5728\u5E03\u5C40\u4E0A\u7684\u8054\u7CFB\uFF0C\u672C\u8D28\u4E0A\u662F\u4E00\u79CD\u6839\u690D\u4E8E\u5171\u540C\u6587\u5316\u57FA\u56E0\u7684\u201C\u540C\u6784\u201D\u5173\u7CFB\u3002\u5B83\u4EEC\u5171\u4EAB\u7740\u201C\u5929\u4EBA\u5408\u4E00\u201D\u7684\u5B87\u5B99\u89C2\u4E0E\u201C\u793C\u5236\u201D\u7684\u793E\u4F1A\u79E9\u5E8F\u89C2\uFF0C\u90FD\u5C06\u81EA\u7136\u79E9\u5E8F\u4E0E\u4EBA\u95F4\u4F26\u7406\u878D\u5408\u4E8E\u5EFA\u7B51\u7A7A\u95F4\u4E4B\u4E2D\u3002\r\n\r\n\u4E8C\u8005\u7684\u6838\u5FC3\u533A\u522B\u5728\u4E8E\u5C3A\u5EA6\u4E0E\u529F\u80FD\u7684\u5347\u534E\uFF1A\u6C11\u5C45\u662F\u793C\u5236\u7684\u4E16\u4FD7\u5316\u4F53\u73B0\uFF0C\u670D\u52A1\u4E8E\u5BB6\u65CF\u751F\u6D3B\u7684\u6709\u5E8F\u8FD0\u884C\uFF1B\u800C\u6545\u5BAB\u5219\u5C06\u8FD9\u5957\u7A7A\u95F4\u903B\u8F91\u63A8\u5411\u4E86\u6781\u81F4\u2014\u2014\u5728\u6C11\u5C45\u56DB\u5408\u9662\u7684\u79C1\u4EBA\u4F26\u7406\u57FA\u7840\u4E0A\uFF0C\u53E0\u52A0\u4E86
    \u201C\u7687\u6743\u5929\u6388\u201D\u7684\u653F\u6559\u8C61\u5F81\u3002\u8FD9\u96C6\u4E2D\u4F53\u73B0\u5728\u6545\u5BAB\u4EE5\u4E94\u884C\u3001\u4E94\u65B9\u3001\u4E94\u8272\u5BF9\u5E94\u5E03\u5C40\u7684\u5B8F\u5927\u53D9\u4E8B\u4E2D\uFF1A\u4E1C\u5BAB\uFF08\u6728/\u9752\u8272\uFF09\u3001\u897F\u5BAB\u517B\u8001\u533A\uFF08\u91D1/\u767D\u8272\uFF09\u3001\u5357\u5348\u95E8\uFF08\u706B/\u7EA2\u8272\uFF09\u3001\u5317\u94A6\u5B89\u6BBF\uFF08\u6C34/\u9ED1\u8272\uFF09\u3001\u4E2D\u592E\u4E09\u5927\u6BBF\uFF08\u571F/\u9EC4\u8272\uFF09\u3002\u8FD9\u5957\u8986\u76D6\u6574\u4E2A\u738B\u671D\u6838\u5FC3\u7684\u9690\u55BB\u7CFB\u7EDF\uFF0C\u5C06\u5E1D\u738B\u7EDF\u6CBB\u7C7B\u6BD4\u4E3A\u5B87\u5B99\u79E9\u5E8F\u7684\u4E2D\u592E\u4E4B\u201C\u571F\u201D\uFF0C\u4EE5\u5EFA\u7B51\u7A7A\u95F4\u5B8C\u6210\u4E86\u5BF9\u7687\u6743\u6B63\u5F53\u6027\u7684\u7EC8\u6781\u8BBA\u8BC1\u3002\r\n\r\n\u5F52\u6839\u7ED3\u5E95\uFF0C\u6545\u5BAB\u5E76\u975E\u6A2A\u7A7A\u51FA\u4E16\u7684\u201C\u7279\u5F02\u5BAB\u6BBF\u201D\uFF0C\u800C\u662F\u4F20\u7EDF\u6C11\u5C45\u7A7A\u95F4\u54F2\u5B66\u5728\u6700\u9AD8\u6743\u529B\u5C42\u9762\u7684\u7CFB\u7EDF\u5316\u3001\u8C61\u5F81\u5316\u4E0E\u795E\u5723\u5316\u3002\u4ECE\u5E73\u6C11\u7684\u56DB\u5408\u9662\u5230\u7687\u5BB6\u7684\u7D2B\u7981\u57CE\uFF0C\u6211\u4EEC\u770B\u5230\u7684\u662F\u540C\u4E00\u5957\u6587\u5316\u5BC6\u7801\u5728\u201C\u5BB6\u201D\u4E0E\u201C\u56FD\u201D\u4E24\u4E2A\u5C42\u9762\u4E0A\u7684\u5EF6\u7EED\u4E0E\u5347\u534E\u2014\u2014\u8FD9\u6B63\u662F\u4E2D\u56FD\u53E4\u4EE3\u5EFA\u7B51\u667A\u6167\u7684\u6DF1\u8FDC\u9B45\u529B\u6240\u5728\u3002"
