  m_text: "\u7406\u89E3\u4E86\u5171\u540C\u7684\u6587\u5316\u6839\u57FA\u4E4B\u540E\uFF0C\u6211\u4EEC\u4FBF\u80FD\u53D1\u73B0\uFF0C\u6545\u5BAB\u4E0E\u6C11\u5C45\u5728\u5E03\u5C40\u4E0A\u5171\u4EAB\u7740\u4E00\u5957\u6DF1\u5C42\u7684\u201C\u57FA\u56E0\u5BC6\u7801\u201D\u3002\r\n\r\n\u8054\u7CFB\u4E00\uFF1A\u540C\u6E90\u7684\u5EFA\u7B51\u57FA\u56E0\u2014\u2014\u201C\u5EAD\u9662\u5F0F\u201D\u9662\u843D\u4F53\u7CFB\r\n\u4E2D\u56FD\u53E4\u5EFA\u7B51\u6700\u57FA\u672C\u7684\u7EC4\u7EC7\u5355\u5143\uFF0C\u5E76\u975E\u72EC\u7ACB\u7684\u5355\u4F53\u623F\u5C4B\uFF0C\u800C\u662F\u7531\u6B63\u623F\u3001\u4E1C\u897F\u53A2\u623F\u7B49\u56F4\u5408\u800C\u6210\u7684\u201C\u9662\u843D\u201D\u3002\u65E0\u8BBA\u662F\u4E61\u91CE\u5C0F\u5B85\u8FD8\u662F\u7687\u5BAB\u5927\u6BBF\uFF0C\u90FD\u5EFA\u7ACB\u5728\u8FD9\u4E00\u5171\u540C\u7684\u201C\u9662\u843D\u201D\u5355\u5143\u4E4B\u4E0A\uFF0C\u529F\u80FD\u590D\u6742\u53EA\u9700\u589E\u52A0\u9662\u843D\u4E32\u8054\uFF0C\u800C\u5F88\u5C11\u5EFA\u9AD8\u697C\u3002\u6B63\u5982\u6709\u5B66\u8005\u6240\u8A00\uFF0C
    \u201C\u4E00\u4E2A\u5EFA\u7B51\u5BF9\u4E2D\u56FD\u4EBA\u6765\u8BF4\uFF0C\u4ECE\u6765\u4E0D\u53EA\u662F\u4E00\u4E2A\u5EFA\u7B51\uFF0C\u800C\u662F\u4E00\u4E2A\u5C0F\u4E16\u754C\u201D
    \u3002\u6545\u5BAB\u672C\u8D28\u4E0A\u5C31\u662F\u4E00\u4E2A\u5DE8\u5927\u7684\u9662\u843D\u7FA4\uFF0C\u6BCF\u4E00\u5EA7\u5BAB\u9662\u4E5F\u90FD\u662F\u6807\u51C6\u56DB\u5408\u9662\u5F62\u5F0F\u3002\u800C\u666E\u901A\u6C11\u5C45\u6B63\u662F\u901A\u8FC7\u4E0D\u540C\u8FDB\u6570\u7684\u9662\u843D\u4E32\u8054\uFF08\u5982\u4E00\u8FDB\u3001\u4E8C\u8FDB\u4E43\u81F3\u591A\u8FDB\u9662\u843D\uFF09\uFF0C\u6765\u5B9E\u73B0\u7A7A\u95F4\u7684\u6709\u5E8F\u5C55\u5F00\u3002\r\n\r\n\u5728\u7A7A\u95F4\u4F53\u9A8C\u4E0A\uFF0C\u4E24\u8005\u4E5F\u4E00\u8109\u76F8\u627F\uFF1A\u53C2\u89C2\u6545\u5BAB\u9700\u8981\u201C\u4ECE\u4E00\u4E2A\u5EAD\u9662\u8D70\u8FDB\u53E6\u4E00\u4E2A\u5EAD\u9662\u201D\uFF0C\u5C42\u5C42\u5C55\u5F00\u5982\u540C\u4E2D\u56FD\u753B\u957F\u5377\uFF1B\u800C\u5B8B\u4EE3\u8BCD\u4EBA\u6B27\u9633\u4FEE\u90A3\u53E5\u201C\u5EAD\u9662\u6DF1\u6DF1\u6DF1\u51E0\u8BB8\u201D\uFF0C\u6B63\u662F\u5BF9\u666E\u901A\u6C11\u5C45\u9662\u843D\u7EB5\u6DF1\u611F\u7684\u751F\u52A8\u63CF\u7ED8\u3002\u53EF\u89C1\uFF0C\u65E0\u8BBA\u662F\u5E1D\u738B\u4E4B\u5BB6\u8FD8\u662F\u5BFB\u5E38\u767E\u59D3\uFF0C\u5176\u7A7A\u95F4\u4F53\u9A8C\u7684\u5E95\u5C42\u903B\u8F91\u662F\u4E00\u81F4\u7684\u3002\r\n\r\n\u8054\u7CFB\u4E8C\uFF1A\u5171\u901A\u7684\u5E03\u5C40\u6CD5\u5219\u2014\u2014\u4E2D\u8F74\u7EBF\u4E0E\u5BF9\u79F0\r\n\u7EB5\u8D2F\u5357\u5317\u7684\u4E2D\u8F74\u7EBF\u662F\u5E03\u5C40\u7684\u6838\u5FC3\uFF0C\u91CD\u8981\u5EFA\u7B51\u4F4D\u4E8E\u8F74\u7EBF\u4E0A\uFF0C\u6B21\u8981\u5EFA\u7B51\u5BF9\u79F0\u5206\u5E03\u4E8E\u4E24\u4FA7\uFF0C\u662F\u7687\u5BAB\u4E0E\u6C11\u5C45\u5171\u540C\u9075\u5FAA\u7684\u539F\u5219\u3002\u5728\u6545\u5BAB\uFF0C\u4E09\u5927\u6BBF\u3001\u4E09\u5927\u5BAB\u7B49\u91CD\u8981\u5EFA\u7B51\u7686\u4F4D\u4E8E\u4E2D\u8F74\u7EBF\uFF1B\u5728\u666E\u901A\u56DB\u5408\u9662\u4E2D\uFF0C\u6B63\u623F\u540C\u6837\u5750\u5317\u671D\u5357\u7F6E\u4E8E\u4E2D\u8F74\uFF0C\u4E24\u4FA7\u914D\u4EE5\u53A2\u623F\uFF0C\u5DE6\u53F3\u5BF9\u79F0\u3002\r\n\r\n\u8054\u7CFB\u4E09\uFF1A\u7EDF\u4E00\u7684\u5E95\u5C42\u903B\u8F91\u2014\u2014\u4EE5\u201C\u793C\u5236\u201D\u4E3A\u6838\u5FC3\u7684\u7B49\u7EA7\u7A7A\u95F4\r\n\u4F5C\u4E3A\u793C\u5236\u601D\u60F3\u7684\u4F53\u73B0\uFF0C\u4E2D\u56FD\u53E4\u4EE3\u5EFA\u7B51\u901A\u8FC7\u9662\u843D\u7EC4\u7EC7\u6765\u4E25\u683C\u533A\u5206\u5C0A\u5351\u957F\u5E7C\u3002\u9662\u843D\u524D\u540E\u4E32\u8054\uFF0C\u5F62\u6210\u5C42\u5C42\u6DF1\u5165\u7684\u7A7A\u95F4\u7ED3\u6784\uFF0C\u4F7F\u5F97\u5BB6\u4E2D\u4E3B\u8981\u4EBA\u7269\u6216\u5E94\u9694\u79BB\u7684\u4EBA\u7269\u5C45\u4F4F\u5728\u8FDC\u79BB\u5916\u95E8\u7684\u9662\u843D\uFF0C\u4ECE\u800C\u5B9E\u73B0\u4E86\u201C\u957F\u5E7C\u6709\u5E8F\uFF0C\u5185\u5916\u6709\u522B\u201D\u7684\u793E\u4F1A\u79E9\u5E8F\u3002\r\n\r\n\u5177\u4F53\u6765\u770B\uFF0C\u5728\u623F\u95F4\u5206\u914D\u4E0A\uFF0C\u7B49\u7EA7\u5DEE\u5F02\u663E\u8457\uFF1A\u6545\u5BAB\u7684\u793C\u5236\u6700\u590D\u6742\uFF0C\u4E1C\u897F\u516D\u5BAB\u7B49\u5EFA\u7B51\u4F9D\u7167\u5C0A\u5351\u3001\u4EB2\u758F\u3001\u8FDC\u8FD1\u7684\u539F\u5219\uFF0C\u5F62\u6210\u7FA4\u661F\u62F1\u6708\u822C\u7684\u4E2D\u9AD8\u5468\u4F4E\u683C\u5C40\uFF1B\u666E\u901A\u56DB\u5408\u9662\u7684\u6B63\u623F\u4F9B\u957F\u8F88\u5C45\u4F4F\uFF0C\u4E1C\u897F\u53A2\u623F\u5206\u5C5E\u665A\u8F88\uFF0C\u5012\u5EA7\u623F\u5219\u7528\u4F5C\u5F85\u5BA2\uFF0C\u540C\u6837\u4F53\u73B0\u4E86\u4E25\u683C\u7684\u623F\u95F4\u7B49\u7EA7\u5236\u5EA6\u3002\r\n\r\n\u5728\u5EFA\u9020\u89C4\u5236\u4E0A\uFF0C\u7B49\u7EA7\u89C4\u8303\u540C\u6837\u7EDF\u4E00\uFF1A\u6C11\u5C45\u5927\u95E8\u5E38\u89C1\u7684\u201C\u95E8\u6795\u77F3\u201D\u201C\u62B1\u9F13\u77F3\u201D\uFF08\u5373\u95E8\u58A9\uFF09\uFF0C\u5176\u9A71\u90AA\u3001\u5409\u7965\u7684\u5BD3\u610F\u4E0E\u7687\u5BAB\u95E8\u524D\u7684\u94DC\u72EE\u4E00\u8109\u76F8\u627F\uFF0C\u4EC5\u5728\u4F53\u91CF\u548C\u7CBE\u7F8E\u7A0B\u5EA6\u4E0A\u6709\u6240\u5DEE\u5F02\u3002\u5728\u5F69\u7ED8\u5236\u5EA6\u4E0A\uFF0C\u6C11\u5C45\u540C\u6837\u53D7\u7B49\u7EA7\u7EA6\u675F\uFF0C\u4E0D\u5F97\u50ED\u8D8A\u3002\r\n\r\n\u8054\u7CFB\u56DB\uFF1A\u4E00\u81F4\u7684\u73AF\u5883\u89C2\u5FF5\u2014\u2014\u98CE\u6C34\u4E0E\u582A\u8206\r\n\u98CE\u6C34\u5B66\u8BF4\u662F\u8D2F\u7A7F\u7687\u5BAB\u4E0E\u6C11\u5C45\u7684\u5171\u540C\u8003\u91CF\u3002\u56DB\u5408\u9662\u7684\u201C\u574E\u5B85\u5DFD\u95E8\u201D\u5E03\u5C40\uFF08\u5750\u5317\u671D\u5357\u3001\u5B85\u95E8\u5F00\u4E8E\u4E1C\u5357\u89D2\uFF09\uFF0C\u6B63\u662F\u98CE\u6C34\u7406\u8BBA\u5728\u666E\u901A\u6C11\u5C45\u4E2D\u7684\u5178\u578B\u8FD0\u7528\uFF0C\u65E8\u5728\u8D8B\u5409\u907F\u51F6\u3002\r\n\r\n\u6545\u5BAB\u540C\u6837\u4EE5\u98CE\u6C34\u89C2\u5FF5\u4E3A\u57FA\u7840\u8FDB\u884C\u89C4\u5212\u3002\u4E1C\u5357\u89D2\u5F00\u5348\u95E8\uFF0C\u6B63\u662F\u4F9D\u636E\u516B\u5366\u65B9\u4F4D\u5E03\u5C40\u3002\u5176\u5185\u90E8\u5BAB\u9662\u4E5F\u9075\u5FAA\u56DB\u5408\u9662\u7684\u98CE\u6C34\u539F\u5219\u3002\u7D2B\u7981\u57CE\u7684\u201C\u65B9\u6B63\u5E03\u7F6E\u6CD5\u201D\u751A\u81F3\u6B63\u5951\u5408\u4E86\u53E4\u4EBA\u201C\u5929\u5706\u5730\u65B9\u201D\u7684\u4F20\u7EDF\u89C2\u5FF5\uFF0C\u4EE5\u6B64\u987A\u5E94\u5929\u9053\uFF0C\u7A81\u51FA\u5A01\u4E25\u5E84\u91CD\u3002\u6545\u5BAB\u7814\u7A76\u5B66\u8005\u66F4\u660E\u786E\u6307\u51FA\uFF0C\u6545\u5BAB\u53E4\u5EFA\u7B51\u7684\u8425\u5EFA\u6587\u5316\u6DF1\u523B\u6DB5\u76D6\u4E86\u201C\u5929\u4EBA\u5408\u4E00\u201D\u201C\u9634\u9633\u5B66\u8BF4\u201D\u201C\u5EFA\u7B51\u98CE\u6C34\u201D\u7B49\u5185\u6DB5\u3002"
